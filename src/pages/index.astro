---
import Layout from "../layouts/Layout.astro";
---

<Layout title="The Lady Slipper">
    <main>
        <figure>
            <img
                src="/images/haeckel-orchideae-plate-74.webp"
                alt="Ernst Haeckel's plate of orchids: lady slippers and other blooms in white, pink, burgundy and gold, crowded on a tan ground"
                width="1400"
                height="2000"
            />
            <figcaption>
                Ernst Haeckel, <cite>Kunstformen der Natur</cite> (1904),
                plate 74: Orchideae.
            </figcaption>
        </figure>
        <h1>The Lady Slipper</h1>
        <p>Coming soon.</p>
        <p class="signup">
            <a href="https://docs.google.com/forms/d/e/1FAIpQLSfipLL6Fh195pDBu0iIRgFyf0QiiZO88HKdQdlnvDcsPzs_TQ/viewform"
                >Get the Bulletin in the mail</a
            >
        </p>
    </main>
</Layout>

<style is:global>
    html {
        background: #f1e4d2;
        color: #3b2a22;
        font-family: "Courier New", Courier, monospace;
    }
    body {
        margin: 0;
    }
    main {
        min-height: 100vh;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
        text-align: center;
    }
    figure {
        margin: 0 0 32px;
    }
    img {
        display: block;
        width: auto;
        max-width: min(100%, 520px);
        max-height: 72vh;
        height: auto;
        margin: 0 auto;
        box-shadow: 0 2px 18px rgba(59, 42, 34, 0.18);
    }
    figcaption {
        margin-top: 12px;
        font-size: 12px;
        color: #7a6555;
    }
    h1 {
        margin: 0;
        font-size: clamp(28px, 6vw, 44px);
        font-weight: normal;
        letter-spacing: 0.04em;
    }
    p {
        margin: 12px 0 0;
        font-size: 18px;
    }
    .signup {
        margin-top: 24px;
    }
    .signup a {
        display: inline-block;
        padding: 10px 18px;
        border: 1.5px solid #3b2a22;
        color: #3b2a22;
        text-decoration: none;
        font-size: 16px;
    }
    .signup a:hover,
    .signup a:focus-visible {
        background: #3b2a22;
        color: #f1e4d2;
    }
</style>
