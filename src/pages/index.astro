---
import Layout from "../layouts/Layout.astro";
---

<Layout title="The Lady Slipper Bulletin">
    <main>
        <h1 class="visually-hidden">The Lady Slipper Bulletin</h1>
        <img
            src="/images/ladyslipper-autumn.webp"
            alt="Sign up for The Lady Slipper Bulletin, for odd fragments of Minneapolis. A watercolor and ink card titled Bde Maka Ska, Minneapolis, Minnesota: an autumn tree branch in red, orange and gold, a falling leaf, two portable toilets, a blue stone pillar, a young tree and green brush, dated 10/26/26."
            width="1500"
            height="2000"
        />
        <a
            class="signup"
            href="https://docs.google.com/forms/d/e/1FAIpQLSfipLL6Fh195pDBu0iIRgFyf0QiiZO88HKdQdlnvDcsPzs_TQ/viewform"
            >Get the Bulletin in the mail</a
        >
    </main>
</Layout>

<style is:global>
    html {
        background: #150e0d;
        color: #dca43c;
        font-family: "Courier New", Courier, monospace;
    }
    body {
        margin: 0;
    }
    main {
        min-height: 100vh;
        min-height: 100svh;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 16px;
        gap: 16px;
    }
    /* The card plus the button always fit in one screen */
    img {
        display: block;
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: calc(100vh - 96px);
        max-height: calc(100svh - 96px);
        /* Feather the photo's edges into the page so its black doesn't show a seam */
        -webkit-mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent),
            linear-gradient(to bottom, transparent, #000 1.5%, #000 98.5%, transparent);
        -webkit-mask-composite: source-in;
        mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent),
            linear-gradient(to bottom, transparent, #000 1.5%, #000 98.5%, transparent);
        mask-composite: intersect;
    }
    .signup {
        display: inline-block;
        padding: 10px 18px;
        border: 1.5px solid #dca43c;
        color: #dca43c;
        text-decoration: none;
        font-size: 16px;
        font-weight: bold;
    }
    .signup:hover,
    .signup:focus-visible {
        background: #dca43c;
        color: #150e0d;
    }
    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
    }
</style>
